# Local Postgres (what palaro/tests/run.sh sets up)
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/palaro

# Supabase — project: palaro-ph (ap-southeast-1)
# Get the password: Supabase dashboard → Project Settings → Database → Reset password
# Use the TRANSACTION POOLER string (port 6543), not the direct connection:
# serverless functions open a connection per invocation and exhaust direct slots.
#
# DATABASE_URL=postgresql://postgres.qvlxxtbkvrwvhdokxcnb:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
